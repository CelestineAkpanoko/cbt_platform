# Copy to .streamlit/secrets.toml (Streamlit Cloud: paste into the app's
# Secrets settings). NEVER commit the real secrets.toml — only this example.

# --- Fitbit OAuth ---
FITBIT_CLIENT_ID = "YOUR_FITBIT_CLIENT_ID"
# MUST exactly match the "Redirect URL" registered in the Fitbit dev console
# AND be this app's own public URL (not the old standalone portal's).
REDIRECT_URI = "https://YOUR-MERGED-APP.streamlit.app"

# --- AWS credentials (Streamlit Cloud has no ambient IAM role) ---
# Use an IAM user scoped to: DynamoDB CRUD on Participants / DeviceAssignments
# / SiteAssignments; s3:PutObject on the tokens bucket; s3:ListBucket on the
# raw sensor bucket (device dropdowns are derived from its prefixes).
# Nothing more.
AWS_ACCESS_KEY_ID = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
AWS_REGION = "us-east-1"

# --- Token storage (unchanged from the standalone auth portal) ---
S3_BUCKET_NAME = "fitbit-study-tokens-stored"
S3_TOKEN_PREFIX = "tokens/"

# --- Enrollment config ---
# Dropdown options (orgs, Cosinuss receivers, Clarity stations) are read
# from the admin-managed DynamoDB "Registry" table — curate them in
# services/admin-portal, not here. The IAM user this app runs as needs
# dynamodb:Query on table/Registry in addition to the tables below.
#
# CBT_ORG_ID / RAW_BUCKET / CLARITY_ID below are FALLBACK ONLY: they matter
# solely if the Registry is empty or briefly unreachable (e.g. first
# rollout, before an admin has seeded it), so the form isn't bricked on
# day one. Once the Registry has entries, these are not consulted.
#
# Historical note: org_id used to be a free-text field on the form — a
# typo there (not these settings) is what caused past org/participant
# mismatches, by silently creating an org no Lambda reader knew about. The
# Registry-backed dropdown closes that; nobody should need to touch these
# three values in normal operation any more.

# Preselects the org dropdown before the Registry loads; provisional value
# stamped into the Fitbit token file at OAuth time, overwritten with the
# real pick on successful enrollment.
CBT_ORG_ID = "org1"

# S3-derived device-inventory fallback for Cosinuss (folder-per-device:
# cosinuss/raw/<id>/) and Clarity (datasourceId column in recent CSVs).
RAW_BUCKET = "raw-data-all-sensors-782329476642-us-east-1-an"

# Comma-separated Clarity station ids, unioned into the S3-derived fallback
# list above. Leave empty once the Registry owns Clarity stations.
CLARITY_ID = "DGFVZ0274"
