# Copy to .streamlit/secrets.toml (Streamlit Cloud: paste into the app's
# Secrets settings). NEVER commit the real secrets.toml — only this example.

# --- Fitbit OAuth ---
FITBIT_CLIENT_ID = "YOUR_FITBIT_CLIENT_ID"
# MUST exactly match the "Redirect URL" registered in the Fitbit dev console
# AND be this app's own public URL (not the old standalone portal's).
REDIRECT_URI = "https://YOUR-MERGED-APP.streamlit.app"

# --- AWS credentials (Streamlit Cloud has no ambient IAM role) ---
# Use an IAM user scoped to: DynamoDB CRUD on Participants / DeviceAssignments
# / SiteAssignments; s3:PutObject on the tokens bucket; s3:ListBucket on the
# raw sensor bucket (device dropdowns are derived from its prefixes).
# Nothing more.
AWS_ACCESS_KEY_ID = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
AWS_REGION = "us-east-1"

# --- Token storage (unchanged from the standalone auth portal) ---
S3_BUCKET_NAME = "fitbit-study-tokens-stored"
S3_TOKEN_PREFIX = "tokens/"

# --- Enrollment config ---
# Default org_id — the form itself lets the registrant edit this per
# submission (see docs/data-model.md), this just pre-fills it.
CBT_ORG_ID = "org1"
# Raw sensor bucket — doubles as the device inventory for Fitbit/Cosinuss
# only (folder-per-device layout: cosinuss/raw/<id>/). fitbit_id is
# auto-captured from the OAuth step (same id data lands under in
# fitbit/raw/<id>/). Nothing to maintain here when wearable hardware changes.
RAW_BUCKET = "raw-data-all-sensors-782329476642-us-east-1-an"

# Clarity is NOT covered by RAW_BUCKET above — its raw data is per-minute
# CSVs (datasourceid/sourceid columns), not a per-device folder, so it
# can't be auto-derived. The Clarity/site id is a typed form field,
# validated against this whitelist (comma-separated if more than one
# station exists later). A submission with a non-matching id is rejected
# with a "contact the research admin" message rather than silently
# misattributing environmental data. Leave unset/empty to disable this
# check entirely (accepts any typed value, unvalidated).
CLARITY_ID = "DGFVZ0274"
