# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud
# Settings → Secrets. See streamlit_app.py's docstring.

# REQUIRED — the portal refuses to start without it.
ADMIN_PASSWORD = "change-me"

# AWS credentials (omit to use ambient credentials locally).
# The IAM user needs:
#  - DynamoDB item CRUD on Participants, DeviceAssignments, SiteAssignments,
#    CalibrationHistory, Registry and Query on their indexes
#    (arn:aws:dynamodb:*:*:table/<name> and table/<name>/index/*);
#  - lambda:GetFunctionConfiguration + lambda:UpdateFunctionConfiguration
#    + lambda:GetFunction on the org-aware functions (see
#    cbt_shared/org_functions.py) — adding an org in the portal pushes
#    the tenant list to them automatically;
#  - lambda:InvokeFunction on calibration-sweep (the "Run calibration
#    check now" button).
# No S3 permissions — the portal never touches S3 by design.
AWS_ACCESS_KEY_ID = ""
AWS_SECRET_ACCESS_KEY = ""
AWS_REGION = "us-east-1"
